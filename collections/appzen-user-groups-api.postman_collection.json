          "id": "a59737be-6894-4523-82f8-25cdd83712b5",
          "name": "Creates/updates a user group",
          "request": {
            "name": "Creates/updates a user group",
            "description": {
              "content": "Creates a user group, or updates the existing one with the same `external_group_id` (upsert).\nAn update is a full replace of the group, including its `members`. Setting `status` to\n`DISABLED` archives the group, and is allowed even while the group is referenced by in-flight\ninvoices or automations. Members that are not existing AppZen users are skipped and returned\nin `unresolved_user_ids` (the request still succeeds).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "user-group"
              ],
              "host": [
                "{{baseUrl}}"
              ],
