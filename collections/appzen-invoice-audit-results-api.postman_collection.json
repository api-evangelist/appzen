        {
          "id": "17abc786-c29c-4370-8e06-9225dbf832cb",
          "name": "Returns a collection of audit results filtered by search parameters.",
          "request": {
            "name": "Returns a collection of audit results filtered by search parameters.",
            "description": {
              "content": "Returns the audit results of an invoice filtered by the following search parameters: supplier-id, invoice-number, invoice-id, uuid. It includes the risk at invoice header level, such as LOW, MEDIUM, HIGH and the overall invoice status, such as Approved, Rejected. Note: supplier-id and invoice-number are always used in tandem : (supplier-id, invoice-number). Otherwise, it will result in HTTP 400 error response.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "invoice",
                "audit-results"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "uuid",
                  "value": "<string>",
                  "description": "Globally unique identifier for an invoice"
                },
                {
                  "disabled": false,
                  "key": "invoice-number",
                  "value": "<string>",
                  "description": "The supplier's invoice number"
                },
                {
                  "disabled": false,
                  "key": "invoice-id",
                  "value": "<string>",
                  "description": "The external invoice id"
                },
                {
                  "disabled": false,
                  "key": "supplier-id",
                  "value": "<string>",
                  "description": "The external supplier id"
                }
              ],
              "variable": []
