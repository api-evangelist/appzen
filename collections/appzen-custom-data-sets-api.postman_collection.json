          "request": {
            "name": "Creates/updates a custom data record",
            "description": {
              "content": "Creates a new Lookup in AppZen (set of named key  value pairs). Returns a uuid for this lookup. When there already exists a lookup (with the same lookup_name and external_id), then the operation is an update (in this case, the `status` in the response will be `UPDATED`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "custom-data"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
